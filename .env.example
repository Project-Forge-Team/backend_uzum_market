# ============================================
# Django Secret Key (ОБЯЗАТЕЛЬНО)
# Сгенерируй новую:
#   python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ============================================
SECRET_KEY=your-secret-key-here

# ============================================
# Debug режим
#   True  — для разработки (локально)
#   False — для продакшена (на Render)
# ============================================
DEBUG=False

# ============================================
# Разрешённые хосты (через запятую)
# Для продакшена укажи домен Render, например:
#   backend-uzum-market.onrender.com,localhost,127.0.0.1
# ============================================
ALLOWED_HOSTS=localhost,127.0.0.1,backend-uzum-market.onrender.com

# ============================================
# CORS разрешённые источники (через запятую)
# Укажи домены фронтенда (Next.js/Vercel/Netlify)
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# База данных (PostgreSQL)
# На Render используется DATABASE_URL (external database URL),
# этот блок нужен только для локальной разработки.
# ============================================
DATABASE_URL=postgres://postgres:your-db-password-here@localhost:5432/uzum_db
