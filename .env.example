# ===========================================================
# Uzum Market Clone — переменные окружения (backend)
# Скопируйте в .env (локально) или задайте в панели хостинга.
# Файл в UTF-8 / LF.
# ===========================================================

# --- ОБЯЗАТЕЛЬНО -------------------------------------------------------------

# Секретный ключ Django (подпись сессий/CSRF). >= 50 символов.
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True — только локальная разработка. На сервере ВСЕГДА False.
DEBUG=False

# Хосты API через запятую, без схемы. Точка перед доменом = поддомены.
ALLOWED_HOSTS=backend-uzum-market.onrender.com,localhost,127.0.0.1

# --- База данных ---------------------------------------------------------------

# По умолчанию SQLite (db.sqlite3) — только для локальной разработки.
# На сервере используйте Postgres:
#   DATABASE_URL=postgres://user:password@host:5432/uzum
# DATABASE_URL=
# DB_SSL_REQUIRE=True          # если провайдер требует SSL (Render — не требует)

# --- CORS / cookie-авторизация --------------------------------------------------

# Источник фронтенда (схема+домен+порт, без слэша). Cookie-сессия требует
# точного совпадения: fetch с credentials: 'include' + этот список.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Для превью-доменов Vercel можно regex:
# CORS_ALLOWED_ORIGIN_REGEXES=^https://[a-z0-9-]+\.vercel\.app$

# Куки: SameSite=Lax работает, когда фронт проксирует /api на тот же домен
# (Next.js rewrite). Если фронт на ДРУГОМ домене (vercel.app → onrender.com),
# поставьте COOKIE_SAMESITE=None (браузер потребует HTTPS — на проде он есть).
COOKIE_SAMESITE=Lax
# COOKIE_SECURE=True            # только по HTTPS (прод). При DEBUG=False включается сам.

# Домен, которому доверяет Django CSRF (для unsafe-запросов из браузера на API):
CSRF_TRUSTED_ORIGINS=https://backend-uzum-market.onrender.com
# CSRF_COOKIE_DOMAIN=.example.com   # если API и фронт на поддоменах одного домена

# --- Демо-режим (§5.8 ТЗ) ---------------------------------------------------------

# Залить сид при сборке/деплое (10 категорий, 43 товара, демо-аккаунты):
SEED_DEMO_DATA=True
# Заблокировать POST /api/demo/reset/ на проде (403 «Демо-режим заблокирован»):
UZUM_LOCK_DEMO=False

# Демо-аккаунты (пароль у всех Password123): seller@uzum.uz, buyer@uzum.uz, electro@uzum.uz

# --- Суперюзер (админка /admin/) ----------------------------------------------

DJANGO_SUPERUSER_EMAIL=admin@uzum.uz
DJANGO_SUPERUSER_PASSWORD=AdminPassword123
# DJANGO_SUPERUSER_FIRST_NAME=Админ
# DJANGO_SUPERUSER_UPDATE_PASSWORD=False   # True — обновлять пароль при каждом деплое

# --- Лимиты (значения по умолчанию; §4 ТЗ) --------------------------------------

# THROTTLE_LOGIN=10/minute        # /auth/login/ на IP (учитывает X-Forwarded-For)
# THROTTLE_REGISTER=10/minute     # /auth/register/ на IP
# THROTTLE_PASSWORD=10/minute     # /auth/password/ на IP
# THROTTLE_CSRF=60/minute         # /auth/csrf/ на IP
# THROTTLE_PRODUCT_WRITE=60/hour  # запись товаров на пользователя

# --- Необязательная инфраструктура ------------------------------------------------

# Общие счётчики троттлинга между worker'ами (иначе каждый worker считает сам):
# REDIS_URL=redis://localhost:6379/0

# Отдавать /media/ через Django (без CDN/_reverse-proxy). На проде лучше
# WhiteNoise/сервер статики или S3.
SERVE_MEDIA=True

# Загрузки в S3 (вместо локального диска; требует requirements/storage.txt):
# USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=

# --- Прод-усиления (включить после проверки HTTPS) ------------------------------

SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# --- Служебное --------------------------------------------------------------------

LOG_LEVEL=INFO
# BACKEND_ID=uzum-backend-1     # попадает в /api/health
