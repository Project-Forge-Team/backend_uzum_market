# ============================================
# SECRET_KEY (ОБЯЗАТЕЛЬНО, >= 50 символов)
# Им же подписываются JWT (HS256) — короткий ключ = подбираемая подпись.
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ============================================
SECRET_KEY=

# ============================================
# DEBUG: True — локально, False — прод
# ============================================
DEBUG=False

# ============================================
# Хосты API (через запятую, без схемы)
# ============================================
ALLOWED_HOSTS=backend-uzum-market.onrender.com,localhost,127.0.0.1

# ============================================
# CORS: только фронтенд, через запятую, ВСЕГДА с протоколом.
# Wildcard "*" при CORS_ALLOW_CREDENTIALS=True не работает.
# ============================================
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000,http://127.0.0.1:3000
# Регулярки для динамических превью-доменов (например Vercel):
# CORS_ALLOWED_ORIGIN_REGEXES=^https://[a-z0-9-]+\.vercel\.app$

# ============================================
# Cookie-авторизация — ВАЖНО
#   Lax   — фронт и API на одном site (например фронт проксирует /api через Next.js).
#   None  — фронт на ДРУГОМ домене (vercel.app → onrender.com). Требует Secure=True
#           (HTTPS) и того, что фронт шлёт заголовок X-CSRFToken на unsafe-запросы
#           (получить его можно через GET /api/auth/csrf/).
# При Lax кросс-сайтовый fetch cookie ни сохраняет, ни отправляет → «логин не работает».
# ============================================
COOKIE_SAMESITE=None
COOKIE_SECURE=True
# COOKIE_DOMAIN=.example.com        # если API и фронт на поддоменах одного домена
# ACCESS_COOKIE_NAME=uzum_access_token
# REFRESH_COOKIE_NAME=uzum_refresh_token

# CSRF-исключения для POST на домене (нужно, если включён SessionAuthentication/admin):
CSRF_TRUSTED_ORIGINS=https://backend-uzum-market.onrender.com

# ============================================
# JWT
# ============================================
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
JWT_ROTATE_REFRESH=True
JWT_BLACKLIST_AFTER_ROTATION=True
# Имена/пути cookie (менять не нужно, если фронт и бэк не живут в разных префиксах):
# ACCESS_COOKIE_NAME=uzum_access_token
# REFRESH_COOKIE_NAME=uzum_refresh_token
# ACCESS_COOKIE_PATH=/
# REFRESH_COOKIE_PATH=/api/auth/
# COOKIE_HTTP_ONLY=True

# ============================================
# База данных
# ============================================
# На Render — Internal Database URL прод-сервиса. На проде DATABASE_URL обязателен;
# без него и при DEBUG=True подключается локальный db.sqlite3.
DATABASE_URL=postgres://postgres:your-db-password-here@d12ab34cd56789.ec1.internal:5432/uzum_db
# DB_CONN_MAX_AGE=600        # переиспользование соединений
# DB_SSL_REQUIRE=True        # sslmode=require (по умолчанию включён на проде для postgres://)

# Статика: Manifest-хранилище WhiteNoise (хэши в именах + Cache-Control: immutable).
# В рантайме включается автоматически, когда staticfiles/ собран; build.sh передаёт
# STATIC_MANIFEST_REQUIRED=1 только для самой команды collectstatic.
# STATIC_MANIFEST_REQUIRED=1
# ============================================
# Кэш + троттлинг (в проде нужен Redis, иначе лимиты «свои» на каждый worker)
# ============================================
# REDIS_URL=rediss://default:password@host:6379
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/hour
THROTTLE_REFRESH=60/hour

# ============================================
# Пагинация/кэш каталога
# ============================================
PAGE_SIZE=10
PAGE_SIZE_MAX=100
CATALOG_CACHE_SECONDS=60

# ============================================
# Медиафайлы. Либо локальный каталог (эфемерный на Render!), либо S3/R2.
# USE_S3=True → build.sh доставит requirements/storage.txt
# ============================================
# USE_S3=True
# AWS_STORAGE_BUCKET_NAME=uzum-market-media
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=media.example.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SERVE_MEDIA=False   # Django отдаёт /media/ (только для локалки; на проде — nginx/CDN)

# ============================================
# Почта (для password reset и т.п.)
# ============================================
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=no-reply@example.com
# EMAIL_HOST_PASSWORD=app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=no-reply@example.com

# ============================================
# Демо-данные и суперюзер
# ============================================
SEED_DEMO_DATA=False
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=your-superuser-password
DJANGO_SUPERUSER_FIRST_NAME=Admin

# Логи
LOG_LEVEL=INFO
